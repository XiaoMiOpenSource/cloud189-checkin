# ============================================================
# 天翼云盘账号配置（必填）
# ============================================================
# 方式一（推荐）：按序号填写，支持任意多个账号
#   TY_USERNAME_1 / TY_PASSWORD_1
#   TY_USERNAME_2 / TY_PASSWORD_2 ...
# 密码含 # $ @ & 空格等特殊字符时用单引号包裹，例如 TY_PASSWORD_1='a#b$c d'
TY_USERNAME_1=your_account
TY_PASSWORD_1=your_password

# 方式二：JSON 数组（一旦设置则忽略方式一）
# TY_ACCOUNTS=[{"userName":"acc1","password":"pwd1"},{"userName":"acc2","password":"pwd2"}]

# ============================================================
# 推送通道（全部可选，留空即不推送）
# ============================================================
# Server 酱  https://sct.ftqq.com/
SENDKEY=
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 企业微信群机器人
WECOM_BOT_KEY=
WECOM_BOT_TELPHONE=
# WxPusher  https://wxpusher.zjiecode.com/
WX_PUSHER_APP_TOKEN=
WX_PUSHER_UID=
# PushPlus  https://www.pushplus.plus/uc.html
PUSH_PLUS_TOKEN=
# ShowDoc  https://push.showdoc.com.cn
SHOWDOC_KEY=
# Bark（iPhone/iPad/Mac） https://bark.day.app/
BARK_KEY=
BARK_SERVER=
# WPUSH  https://wpush.cn/settings
WPUSH_APIKEY=
WPUSH_CHANNEL=
WPUSH_TOPIC_CODE=

# ============================================================
# 调试
# ============================================================
# 设为 1 输出 SDK 详细请求日志
CLOUD189_VERBOSE=0
